PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bizfinder_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d
BASE_URL=http://localhost:5001

# Email (SMTP) delivery for login OTPs - required in every environment
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="Rotaract Clubs <no-reply@example.com>"
APP_NAME=Rotaract Clubs

# Link placed in admin invitation emails (optional)
ADMIN_PANEL_URL=
